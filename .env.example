# --- Login credentials (required for the authenticated Client) ---
# Username, email, or phone number.
TWITTER_AUTH_INFO_1=your_username
# A second identifier (email if the first is a username). Optional but recommended.
TWITTER_AUTH_INFO_2=your_email@example.com
TWITTER_PASSWORD=your_password

# --- Optional ---
# Base32 TOTP secret, if the account has 2FA enabled. Without it, the login
# prompts for a code on stdin.
TWITTER_TOTP_SECRET=
# Where to cache cookies so later runs skip the login flow.
TWITTER_COOKIES_FILE=cookies.json
# Proxy for all requests, e.g. http://user:pass@host:port or socks5://host:port
TWITTER_PROXY=
# Capsolver API key, to auto-solve the Arkose captcha if the account gets locked.
CAPSOLVER_API_KEY=

# --- For the smoke test ---
# A screen name to read public data from.
TEST_SCREEN_NAME=jack
